generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SALESMAN
}

enum Unit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACKET
  BOX
}

enum StockTransactionType {
  OPENING_STOCK
  STOCK_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  SALE_CANCEL
}

enum RateType {
  NORMAL
  RETAIL
  FUNCTION
}

enum PaymentType {
  CASH
  UPI
}

enum BillStatus {
  COMPLETED
  CANCELLED
}

enum LabelSize {
  LABEL_50X40
  LABEL_50X50
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  passwordHash      String             @map("password_hash")
  role              Role
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockTransactions StockTransaction[]
  createdBills      Bill[]             @relation("BillCreator")
  cancelledBills    Bill[]             @relation("BillCanceller")

  @@map("users")
}

model Category {
  id           Int      @id @default(autoincrement())
  categoryName String   @unique @map("category_name")
  tamilName    String?  @map("tamil_name")
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([active, displayOrder])
  @@map("categories")
}

model Product {
  id                Int                @id @default(autoincrement())
  productCode       String             @unique @map("product_code")
  barcode           String?            @unique
  productName       String             @map("product_name")
  tamilName         String?            @map("tamil_name")
  categoryId        Int                @map("category_id")
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit              Unit
  mrpRate           Decimal            @default(0.00) @map("mrp_rate") @db.Decimal(12, 2)
  originalRate      Decimal            @default(0.00) @map("original_rate") @db.Decimal(12, 2)
  normalRate        Decimal            @default(0.00) @map("normal_rate") @db.Decimal(12, 2)
  retailRate        Decimal            @default(0.00) @map("retail_rate") @db.Decimal(12, 2)
  functionRate      Decimal            @default(0.00) @map("function_rate") @db.Decimal(12, 2)
  currentStock      Decimal            @default(0.000) @map("current_stock") @db.Decimal(12, 3)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockTransactions StockTransaction[]
  billItems         BillItem[]

  @@index([categoryId])
  @@map("products")
}

model StockTransaction {
  id            Int                  @id @default(autoincrement())
  productId     Int                  @map("product_id")
  type          StockTransactionType
  quantity      Decimal              @db.Decimal(12, 3)
  previousStock Decimal              @map("previous_stock") @db.Decimal(12, 3)
  newStock      Decimal              @map("new_stock") @db.Decimal(12, 3)
  createdBy     Int                  @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  note          String?
  billId        Int?                 @map("bill_id")

  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])
  bill    Bill?   @relation(fields: [billId], references: [id])

  @@index([productId])
  @@index([createdBy])
  @@index([billId])
  @@map("stock_transactions")
}

model Bill {
  id                  Int         @id @default(autoincrement())
  billNumber          String      @unique @map("bill_number")
  rateType            RateType    @map("rate_type")
  paymentType         PaymentType @map("payment_type")
  subtotal            Decimal     @db.Decimal(12, 2)
  totalAmount         Decimal     @map("total_amount") @db.Decimal(12, 2)
  status              BillStatus  @default(COMPLETED)
  createdBy           Int         @map("created_by")
  cancelledAt         DateTime?   @map("cancelled_at")
  cancelledBy         Int?        @map("cancelled_by")
  receiptStoreName    String      @map("receipt_store_name")
  receiptUpiId        String?     @map("receipt_upi_id")
  receiptGstin        String?     @map("receipt_gstin")
  receiptShowCashier  Boolean     @default(true) @map("receipt_show_cashier")
  receiptShowRateTier Boolean     @default(true) @map("receipt_show_rate_tier")
  receiptShowPayment  Boolean     @default(true) @map("receipt_show_payment")
  receiptShowStatus   Boolean     @default(true) @map("receipt_show_status")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  creator           User               @relation("BillCreator", fields: [createdBy], references: [id])
  canceller         User?              @relation("BillCanceller", fields: [cancelledBy], references: [id])
  items             BillItem[]
  stockTransactions StockTransaction[]

  @@index([createdBy])
  @@index([cancelledBy])
  @@map("bills")
}

model BillItem {
  id          Int      @id @default(autoincrement())
  billId      Int      @map("bill_id")
  productId   Int      @map("product_id")
  productCode String   @map("product_code")
  productName String   @map("product_name")
  tamilName   String?  @map("tamil_name")
  unit        Unit
  quantity    Decimal  @db.Decimal(12, 3)
  rateType    RateType @map("rate_type")
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

model BillSequence {
  id         Int      @id @default(autoincrement())
  prefix     String   @unique
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("bill_sequences")
}

model ReceiptSettings {
  id           Int      @id @default(autoincrement())
  storeName    String   @map("store_name")
  upiId        String?  @map("upi_id")
  gstin        String?  @map("gstin")
  showCashier  Boolean  @default(true) @map("show_cashier")
  showRateTier Boolean  @default(true) @map("show_rate_tier")
  showPayment  Boolean  @default(true) @map("show_payment")
  showStatus   Boolean  @default(true) @map("show_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("receipt_settings")
}

model LabelSettings {
  id               Int       @id @default(autoincrement())
  storeName        String    @map("store_name")
  defaultLabelSize LabelSize @default(LABEL_50X40) @map("default_label_size")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("label_settings")
}
